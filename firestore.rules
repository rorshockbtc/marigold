rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Relay Blobs are for encrypted sync
    // Ensure only authenticated users can read/write
    match /relay_blobs/{document=**} {
      // Basic rule: only authenticated users can read and write blobs
      // The API server (via Clerk) handles the actual writing for IDOR prevention, 
      // but if the client tries to read/write directly, we enforce auth.
      allow read, write: if request.auth != null;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
